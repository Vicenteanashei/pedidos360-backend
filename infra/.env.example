# Identifiers are public; obtain them from your own Entra registrations.
ENTRA_TENANT_ID=
SPA_CLIENT_ID=
API_CLIENT_ID=
PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Generate private values with python3 scripts/configure-local.py, then fill the IDs.
# Base de datos. En AWS: endpoint de RDS for Oracle (privado), por ejemplo
#   DB_URL=jdbc:oracle:thin:@//pedidos360.xxxxxxxx.us-east-1.rds.amazonaws.com:1521/ORCL
# Vacío = contenedor Oracle local (perfil local-db) y entonces ORACLE_ADMIN_PASSWORD es obligatorio.
# Con RDS, ORACLE_ADMIN_PASSWORD queda vacío: la contraseña maestra no se guarda en la EC2.
DB_URL=
ORACLE_ADMIN_PASSWORD=
ORDERS_DB_PASSWORD=
CATALOG_DB_PASSWORD=
NOTIFY_DB_PASSWORD=
INTERNAL_SERVICE_KEY=
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=
RABBITMQ_COOKIE=
# On EC2 backend, set MQ private addresses and Management URL; do not use Docker names across hosts.
RABBITMQ_ADDRESSES=rabbit1:5672,rabbit2:5672,rabbit3:5672
RABBIT_MANAGEMENT_URL=http://rabbit1:15672
CATALOG_PROFILE=demo
DEMO_FAILURE_ENABLED=false
# true: notify archiva y confirma los mensajes de las DLQ. false: quedan en las DLQ (para mostrarlos en Management).
DLQ_LISTENER_ENABLED=true

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

RABBIT_ADMIN_USER=mqadmin
RABBIT_ADMIN_PASSWORD=
VITE_DIAGNOSTICS=false

# Business dates; instants remain stored in UTC.
REPORT_TIME_ZONE=America/Santiago
