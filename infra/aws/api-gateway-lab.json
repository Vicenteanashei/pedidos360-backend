{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Pedidos360 EA2: API Gateway HTTP API con JWT de Entra hacia el BFF por VPC Link y ALB interno. El frontend se sirve aparte desde S3 + CloudFront (CORS restringido a ese origen).",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Description": "VPC de las tres EC2 existentes"
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Primera subnet del VPC"
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Segunda subnet del mismo VPC, otra zona de disponibilidad"
    },
    "BackendInstanceId": {
      "Type": "AWS::EC2::Instance::Id",
      "Description": "EC2 backend existente; no crea otra instancia"
    },
    "BackendSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "TenantId": {
      "Type": "String",
      "AllowedPattern": "[0-9a-fA-F-]{36}"
    },
    "ApiClientId": {
      "Type": "String",
      "AllowedPattern": "[0-9a-fA-F-]{36}"
    },
    "FrontendOrigin": {
      "Type": "String",
      "Description": "Origen HTTPS del frontend en CloudFront, sin barra final (salida FrontendUrl del stack del frontend). Ej: https://d111111abcdef8.cloudfront.net",
      "AllowedPattern": "^https://[A-Za-z0-9.-]+$",
      "ConstraintDescription": "Usar https://<dominio> sin ruta ni barra final"
    }
  },
  "Rules": {
    "DifferentSubnets": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "SubnetA"
                  },
                  {
                    "Ref": "SubnetB"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "Seleccionar dos subnets distintas; verificar tambien que sus AZ sean distintas."
        }
      ]
    }
  },
  "Resources": {
    "AlbSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "ALB interno: VPC Link hacia el BFF",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "DestinationSecurityGroupId": {
              "Ref": "BackendSecurityGroupId"
            }
          }
        ]
      }
    },
    "VpcLinkSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "API Gateway VPC Link: solo ALB interno",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "DestinationSecurityGroupId": {
              "Ref": "AlbSG"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 81,
            "ToPort": 81,
            "DestinationSecurityGroupId": {
              "Ref": "AlbSG"
            }
          }
        ]
      }
    },
    "AllowLinkToAlb": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "AlbSG"
        },
        "IpProtocol": "tcp",
        "FromPort": 80,
        "ToPort": 80,
        "SourceSecurityGroupId": {
          "Ref": "VpcLinkSG"
        }
      }
    },
    "AllowAlbToBff": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "BackendSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "AlbSG"
        },
        "Description": "Pedidos360 API Gateway via ALB privado"
      }
    },
    "InternalAlb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internal",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSG"
          }
        ]
      }
    },
    "BffTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "TargetType": "instance",
        "Port": 8080,
        "Protocol": "HTTP",
        "HealthCheckPath": "/actuator/health",
        "Matcher": {
          "HttpCode": "200"
        },
        "Targets": [
          {
            "Id": {
              "Ref": "BackendInstanceId"
            },
            "Port": 8080
          }
        ]
      }
    },
    "AlbListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "InternalAlb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "BffTargetGroup"
            }
          }
        ]
      }
    },
    "ApiVpcLink": {
      "Type": "AWS::ApiGatewayV2::VpcLink",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-link"
        },
        "SubnetIds": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "VpcLinkSG"
          }
        ]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            {
              "Ref": "FrontendOrigin"
            }
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "OPTIONS"
          ],
          "AllowHeaders": [
            "authorization",
            "content-type",
            "x-correlation-id"
          ],
          "ExposeHeaders": [
            "x-correlation-id",
            "content-disposition"
          ],
          "MaxAge": 600
        }
      }
    },
    "EntraAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "Name": "Entra-access-token",
        "AuthorizerType": "JWT",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "JwtConfiguration": {
          "Audience": [
            {
              "Ref": "ApiClientId"
            }
          ],
          "Issuer": {
            "Fn::Sub": "https://login.microsoftonline.com/${TenantId}/v2.0"
          }
        }
      }
    },
    "BffIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "HTTP_PROXY",
        "IntegrationMethod": "ANY",
        "IntegrationUri": {
          "Ref": "AlbListener"
        },
        "ConnectionType": "VPC_LINK",
        "ConnectionId": {
          "Ref": "ApiVpcLink"
        },
        "PayloadFormatVersion": "1.0",
        "RequestParameters": {
          "overwrite:path": "$request.path"
        },
        "TimeoutInMillis": 20000
      }
    },
    "Route1": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /api/data",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "BffIntegration"
              }
            ]
          ]
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "EntraAuthorizer"
        },
        "AuthorizationScopes": [
          "access_as_user"
        ]
      }
    },
