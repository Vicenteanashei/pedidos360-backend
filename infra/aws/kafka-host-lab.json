{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Pedidos360 EA3: dedicated Kafka lab host. Logical three-broker/three-ZooKeeper cluster; no secrets or IAM grants.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "BackendSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "SshSourceCidr": {
      "Type": "String",
      "Description": "Administrative IPv4 CIDR or regional EC2 Instance Connect CIDR; never 0.0.0.0/0",
      "AllowedPattern": "^(?!0\\.0\\.0\\.0/0$)([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.large",
      "AllowedValues": [
        "t3.large",
        "t3.xlarge",
        "m6i.large",
        "m6i.xlarge"
      ]
    }
  },
  "Resources": {
    "KafkaSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Kafka private access from backend, SSH administration",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 9092,
            "ToPort": 9094,
            "SourceSecurityGroupId": {
              "Ref": "BackendSecurityGroupId"
            },
            "Description": "Kafka listeners from app host"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "SshSourceCidr"
            },
            "Description": "Administrative access"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "pedidos360-ea3-kafka"
          }
        ]
      }
    },
    "KafkaHost": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Ref": "KafkaSG"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 40,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\ndnf install -y docker python3 git\nsystemctl enable --now docker\nusermod -aG docker ec2-user\nmkdir -p /usr/local/lib/docker/cli-plugins\ncurl -fsSL https://github.com/docker/compose/releases/download/v2.40.3/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose\nchmod +x /usr/local/lib/docker/cli-plugins/docker-compose"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "pedidos360-ea3-kafka"
          }
        ]
      }
    }
  },
  "Outputs": {
    "KafkaInstanceId": {
      "Value": {
        "Ref": "KafkaHost"
      }
    },
    "KafkaPrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "KafkaHost",
          "PrivateIp"
        ]
      }
    },
    "KafkaSecurityGroupId": {
      "Value": {
        "Ref": "KafkaSG"
      }
    }
  }
}
